# PTAI - Local Autonomous Trading Agent
# Copy to .env and fill
# Supports LM Studio (primary) and Ollama

# --- Bankroll & Self-Preservation ---
BANKROLL=50.0
CURRENCY=USD
DAILY_COST_TO_COVER=5.0  # How much agent must earn per day to "pay for itself"
SHUTDOWN_IF_UNPROFITABLE_DAYS=3
MAX_DAILY_LOSS_PCT=0.15  # Stop trading if down 15% in a day
MAX_TOTAL_DRAWDOWN_PCT=0.30  # Shutdown if down 30% total

# --- Polymarket ---
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_CHAIN_ID=137
POLYMARKET_SIGNATURE_TYPE=1
POLYMARKET_HOST=https://clob.polymarket.com
GAMMA_API=https://gamma-api.polymarket.com
DRY_RUN=true  # Set false to execute real trades

# --- Local LLM - LM STUDIO (RECOMMENDED FOR YOU) ---
# LM Studio runs OpenAI compatible server at http://localhost:1234 by default
# Steps: Open LM Studio -> Developer tab -> Start Server -> Load a model
# YOU HAVE: deepseek-r1-distill-qwen-32b (SLOW 8 min), qwen/qwen3-32b (FAST 3 sec), qwen/qwen3.8-27b
# BEST FOR TRADING: qwen/qwen3-32b - 2-3 sec per market, 50 deep = 2.5 min fits 10 min!
# R1 is 8 min per market due to <think> reasoning - too slow for 10 min interval
LLM_PROVIDER=auto  # auto, lm_studio, ollama, openai_compatible
LM_STUDIO_HOST=http://localhost:1234
LM_STUDIO_MODEL=local-model  # "local-model" = auto. Auto picks the first LOADED
# model that is not R1-style, so a slow reasoning model sitting first in LM
# Studio's list can no longer become the model the agent calls. Pin an exact
# name (or use the console's Setup page) to override.
LLM_TIMEOUT_SECONDS=180  # how long the agent waits for ONE market's forecast.
# Measured on this machine: an R1 model needed ~9 minutes for a single market,
# which cannot fit a 10-minute cycle. Bounded, a slow model returns no forecast
# (and says so) instead of holding the loop. Raise it if you know your model is
# slower than 3 minutes per market; lower it to keep cycles tight.
LM_STUDIO_API_KEY=lm-studio  # LM Studio default, any string works

# --- Local LLM - Ollama (Alternative) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# For fair value reasoning, 8b+ recommended, 70b ideal if you have VRAM

# Fallback OpenAI compatible (optional, for testing)
OPENAI_API_KEY=lm-studio
OPENAI_BASE_URL=http://localhost:1234/v1
USE_LOCAL_LLM=true

# --- X / Twitter Sentiment (local scraping, no API needed) ---
# NOTE: X now BLOCKS snscrape (404 graphql SearchTimeline) as of 2024+ 
# If blocked, agent auto-enables circuit breaker after 3 fails and skips X (fast)
# FIX: SENTIMENT_USE_X=false disables X entirely, uses LLM-only (fastest, 0 sec)
# RECOMMENDED FOR R1 MODELS: false (R1 already 8 min per market, X adds 40 sec)
# For fast trading with qwen3-32b: false gives 4 min total cycle fits 10 min!
SENTIMENT_USE_X=false
# Option 1: Use snscrape (no credentials, but NOW OFTEN BLOCKED 404)
X_USE_SNSCRAPE=true
# Option 2: Use official API if you have it (optional)
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# Option 3: Browser scraping via Playwright (uses your logged-in session) - WORKS when snscrape blocked
X_USE_BROWSER=false
# Performance: reduced from 100 to 60 markets for sentiment to stay in 10min window
# R1 reasoning models are EXTREMELY SLOW (7-8 min per market) - auto-detected to 5 deep
# For FAST trading (10 min cycle): use qwen/qwen3-32b non-R1, set 50 deep
# For R1 trading: set 5 deep and SCAN_INTERVAL=60 (hourly)
MAX_DEEP_ANALYZE=50  # 30 for 70B/72B, 50 for 32B fast, 5 for R1 slow (auto-detected), 100 for 14B

# --- R1 SLOW FIX - RECOMMENDED FOR YOUR MODELS ---
# You have: deepseek-r1-distill-qwen-32b (8 min SLOW), qwen/qwen3-32b (3 sec FAST)
# FAST CONFIG (fits 10 min):
# LM_STUDIO_MODEL=qwen/qwen3-32b
# SENTIMENT_USE_X=false
# MAX_DEEP_ANALYZE=50
# SCAN_INTERVAL_MINUTES=10
# Result: 500 scan (1 sec) + 0 sentiment + 50*3 sec = 4 min total!
#
# SLOW R1 CONFIG (if you must use R1):
# LM_STUDIO_MODEL=deepseek-r1-distill-qwen-32b
# SENTIMENT_USE_X=false
# MAX_DEEP_ANALYZE=5
# SCAN_INTERVAL_MINUTES=60
# Result: 5*8 min = 40 min per cycle, run hourly

# --- Browser Execution ---
BROWSER_HEADLESS=false
BROWSER_PERSISTENT_DIR=./browser/profiles/default
BROWSER_STEALTH=true
BROWSER_TIMEOUT=30000

# --- Risk ---
MAX_POSITION_PCT=0.06  # 6% max per Kelly
MIN_EDGE_PCT=0.08  # 8% mispricing threshold
MAX_OPEN_POSITIONS=8
KELLY_FRACTION=0.5  # Half-Kelly for safety
MIN_LIQUIDITY=1000
MIN_VOLUME_24H=5000

# --- Agent Loop ---
SCAN_INTERVAL_MINUTES=10
SCAN_MARKETS_COUNT=500
SCAN_ORDER_BY=volume24hr
LOG_LEVEL=INFO

# --- Notifications ---
NOTIFIER_ENABLED=true
